# =====================================================================
# 外包点评 · 本地开发环境变量示例
# 复制为 .env 后按需修改；.env 不提交仓库。
# =====================================================================

# ---------- 数据库（本机原生 PostgreSQL，默认 PostgreSQL 18） ----------
# DB_USER 改成你的本机用户名（whoami），本机 Homebrew PostgreSQL 默认使用 trust 认证，密码可留空
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waibao_dev
DB_USER=wjq
DB_PASSWORD=

# ---------- Redis（验证码/限频/会话/缓存/分布式锁） ----------
# 本机启动：brew services start redis
# 测试固定使用 DB 15，并按随机前缀隔离，避免污染开发库 DB 0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- RabbitMQ（导入 / 通知 / AI 初审消息驱动） ----------
# 本机启动：brew services start rabbitmq（管理台 http://localhost:15672）
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# true：生产默认走 RabbitMQ；false：进程内同步执行（集成测试固定为 false）
APP_MQ_ASYNC=true

# ---------- 后端 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=mock

# ---------- XXL-Job（分布式定时任务；admin 与执行器） ----------
# 执行器注册开关：集成测试固定关闭；本地联调保持 true
XXL_JOB_ENABLED=true
# 调度中心地址（含 context path，多个用逗号分隔）
XXL_JOB_ADMIN_ADDRESSES=http://localhost:8081/xxl-job-admin
# 执行器与调度中心通信令牌，必须与 admin 的 xxl.job.accessToken 一致
XXL_JOB_ACCESS_TOKEN=waibao_xxl_token
XXL_JOB_EXECUTOR_APPNAME=waibao-executor
# 执行器地址/IP 留空表示自动探测（注册到 xxl_job_registry 的地址为 IP:PORT）
XXL_JOB_EXECUTOR_ADDRESS=
XXL_JOB_EXECUTOR_IP=
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_LOG_PATH=/tmp/xxl-job-executor
XXL_JOB_LOG_RETENTION_DAYS=30

# 本地 XXL-Job admin 自用 MySQL（库由 infra/xxl-job/tables_xxl_job.sql 初始化）
XXL_DB_HOST=127.0.0.1
XXL_DB_PORT=3306
XXL_DB_NAME=xxl_job
XXL_DB_USER=xxl
XXL_DB_PASSWORD=xxl_dev_password
XXL_JOB_ADMIN_PORT=8081

# Provider 模式：mock | real
PROVIDERS_MODE=mock
# Mock 短信固定验证码
MOCK_SMS_FIXED_CODE=123456
# Mock 实名认证强制失败的身份证号（可留空）
MOCK_REALNAME_FAIL_ID=

# JWT 签名密钥（开发默认值仅用于本地，生产必须重新生成 ≥ 32 字节随机串）
JWT_SECRET=dev-only-jwt-secret-change-me-32bytes-min

# 敏感数据加密主密钥（Base64，32 字节；开发默认值仅用于本地）
# 生成方式：openssl rand -base64 32
STORAGE_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# 手机号 / 证件号 AES-GCM 加密密钥（32 字节随机串或 Base64；缺失时后端启动失败）
# 生成方式：openssl rand -base64 32
CRYPTO_DATA_KEY=ZGV2LW9ubHktY3J5cHRvLWRhdGEta2V5LTMyYnl0ZXM=
# 手机号唯一索引 HMAC-SHA256 密钥（建议 ≥32 字节随机串；生产必须替换）
CRYPTO_HMAC_KEY=dev-only-hmac-key-change-me-please-32bytes

# ---------- 种子管理员（仅当变量存在时写入；不提交真实凭据） ----------
ADMIN_SEED_ACCOUNT=admin
ADMIN_SEED_PASSWORD=admin_dev_password
ADMIN_SEED_ROLE=SUPER_ADMIN

# ---------- 前台 ----------
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- 后台 ----------
VITE_API_BASE=http://localhost:8080
